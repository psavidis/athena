+          RandomPicks.randomFrom(random(), VectorSimilarityFunction.values());
+      List<String> deleted = new ArrayList<>();
+      for (int i = 0; i < 2 * DOCS_PER_SEGMENT; i++) {
+        if (random().nextInt(10) == 0) {
