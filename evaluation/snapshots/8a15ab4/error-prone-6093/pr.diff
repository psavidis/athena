+                if (Class.forName(s) != null) {}
+                // BUG: Diagnostic contains:
+                if (null == Class.forName(s)) {}
+                // BUG: Diagnostic contains:
+                if (null != Class.forName(s)) {}
+                // BUG: Diagnostic contains:
+                if (Class.forName(s, true, loader) == null) {}
+                // BUG: Diagnostic contains:
+                assertThat(Class.forName(s)).isNotNull();
