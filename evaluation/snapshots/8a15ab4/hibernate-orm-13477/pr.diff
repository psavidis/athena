diff --git a/hibernate-core/src/test/java/org/hibernate/orm/test/where/annotations/RestrictedSecondaryTableTest.java b/hibernate-core/src/test/java/org/hibernate/orm/test/where/annotations/RestrictedSecondaryTableTest.java
