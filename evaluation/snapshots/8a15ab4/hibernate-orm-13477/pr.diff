+			final var unused = session.enableFilter( "visibilityUnused" ).setParameter( "value", 0 );
+			try ( var rows = session.createNativeQuery( sql( uniqueKey ), type( uniqueKey ) ).scroll( ScrollMode.FORWARD_ONLY ) ) {
